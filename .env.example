# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Konnect Payment Gateway
NEXT_PUBLIC_KONNECT_API_URL="https://api.konnect.network"
KONNECT_API_URL="https://api.konnect.network"
KONNECT_EMAIL="your-konnect-email"
KONNECT_PASSWORD="your-konnect-password"
KONNECT_TAX_ID="your-tax-id"

# Webhook Base URL
WEBHOOK_BASE_URL="https://your-domain.com"

# AWS SES SMTP Configuration for Email
SMTP_HOST="email-smtp.eu-west-1.amazonaws.com"
SMTP_PORT="587"
SMTP_USERNAME="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
FROM_EMAIL="noreply@your-domain.com"